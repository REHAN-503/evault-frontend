# Base URL of the Backend API Gateway (Node.js/Express) described in section 2 of the
# architecture doc. Point this at wherever the real service is deployed.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# When true, every function in src/api/* returns realistic mock data instead of calling
# the network. This lets the whole UI run and demo standalone before the backend,
# blockchain network, and database are wired up. Flip to false (or delete the var) the
# moment the real API Gateway is reachable — no component code needs to change.
VITE_USE_MOCK=true
